# Entradas, nesta ordem: n_fatorial (inteiro de 0 a 12) e quantidade_termos (0 a 45).
# Esses limites mantem o fatorial e as somas de Fibonacci dentro de um int de 32 bits.
func inteiro_no_intervalo(valor, minimo, maximo) {
    var candidato = minimo;
    while (candidato <= maximo) {
        if (valor == candidato) {
            return true;
        }
        candidato = candidato + 1;
    }
    return false;
}

seq {
    var n_fatorial = to_number(input("Numero para o fatorial (inteiro de 0 a 12): "));
    var quantidade_termos = to_number(input("Quantidade de termos de Fibonacci (inteiro de 0 a 45): "));

    if (inteiro_no_intervalo(n_fatorial, 0, 12) && inteiro_no_intervalo(quantidade_termos, 0, 45)) {
        var fat = 1;
        var fibonacci = [];

        par {
            seq {
                var i = 1;
                while (i <= n_fatorial) {
                    fat = fat * i;
                    i = i + 1;
                }
            }
            seq {
                var a = 0;
                var b = 1;
                var i = 0;
                while (i < quantidade_termos) {
                    fibonacci.append(a);
                    var prox = a + b;
                    a = b;
                    b = prox;
                    i = i + 1;
                }
            }
        }

        # Os calculos ocorrem em paralelo; a exibicao apos o join preserva a ordem.
        print("Fatorial de", n_fatorial, "=", fat);
        print("Fibonacci - quantidade de termos:", quantidade_termos);
        # Listas usam double; o limite validado permite exibir cada termo como inteiro exato.
        var termo_inteiro = 0;
        var indice = 0;
        while (indice < quantidade_termos) {
            termo_inteiro = fibonacci[indice];
            print(termo_inteiro);
            indice = indice + 1;
        }
    } else {
        print("Entrada invalida: informe inteiros de 0 a 12 para o fatorial e de 0 a 45 para Fibonacci.");
    }
}
