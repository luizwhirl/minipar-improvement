# Teste 9: 5 núcleos, 4 avaliadores e 1 fractal de Mandelbrot (fork/join)
# Baseado no script Python "Teste9-5Nucleos-4Avaliadores-UmFractal".
# Núcleos 1 a 4 corrigem as 160 atividades; o núcleo 5 calcula o fractal.

# ------------------------------------------------------------------
# PASSO 1: RECURSOS NATIVOS
# ------------------------------------------------------------------

# Simula o tempo de correção gastando CPU (no Python: simular_atraso).
# A soma é devolvida e usada depois, para o g++ (-O3) não apagar o laço.
func simular_atraso(iteracoes) {
    var soma = 0.0;
    var i = 0;
    while (i < iteracoes) {
        soma = soma + i;
        i = i + 1;
    }
    return soma;
}

# Sorteio fixo do tempo de correção (no Python: meu_random_uniforme).
# Cada atividade tem sempre o mesmo tempo, entre 0.05 e 0.15 "segundos",
# assim a saída é igual em toda execução, mesmo com várias threads.
func tempo_correcao(indice) {
    var estado = ((indice * 1103) + 12345) % 65536;
    return 0.05 + (0.10 * (estado / 65535.0));
}

# Nome de cada avaliador (no Python: lista AVALIADORES)
func nome_avaliador(id) {
    if (id == 0) { return "Professor"; }
    if (id == 1) { return "Monitor 1"; }
    if (id == 2) { return "Monitor 2"; }
    return "Monitor 3";
}

# ------------------------------------------------------------------
# PASSO 3: FUNÇÕES DE TRABALHO DOS NÚCLEOS
# ------------------------------------------------------------------

# Corrige uma atividade. Devolve 1 quando terminou.
func avaliar_atividade(indice) {
    var soma = simular_atraso(tempo_correcao(indice) * 15000000);
    if (soma < indice) { return 0; }
    return 1;
}

# Trabalho de um núcleo: corrige as atividades de "inicio" até "fim - 1"
# e devolve quantas corrigiu (o join só devolve número).
func trabalhador_nucleo(inicio, fim) {
    var corrigidas = 0;
    var indice = inicio;
    while (indice < fim) {
        corrigidas = corrigidas + avaliar_atividade(indice);
        indice = indice + 1;
    }
    return corrigidas;
}

# Caractere de cada faixa de iterações (no Python: " .:-=+#%@")
func caractere(faixa) {
    if (faixa == 0) { return " "; }
    if (faixa == 1) { return "."; }
    if (faixa == 2) { return ":"; }
    if (faixa == 3) { return "-"; }
    if (faixa == 4) { return "="; }
    if (faixa == 5) { return "+"; }
    if (faixa == 6) { return "#"; }
    if (faixa == 7) { return "%"; }
    return "@";
}

# Núcleo 5: calcula e imprime o fractal de Mandelbrot em ASCII.
# Devolve quantos pontos ficaram dentro do conjunto.
# "mostrar" = 1 imprime o desenho; 0 só calcula (modo sequencial).
func trabalhador_mandelbrot(largura, altura, max_iter, mostrar) {
    var tela = matrix(altura, largura, " ");
    var dentro = 0;
    var y = 0;
    while (y < altura) {
        # Mapeia Y para o plano complexo [-1.2, 1.2]
        var cy = ((y * 2.4) / altura) - 1.2;
        var x = 0;
        while (x < largura) {
            # Mapeia X para o plano complexo [-2.0, 1.0]
            var cx = ((x * 3.0) / largura) - 2.0;

            # Equação do fractal: z = z^2 + c
            var zx = 0.0;
            var zy = 0.0;
            var iteracao = 0;
            while ((((zx * zx) + (zy * zy)) <= 4.0) && (iteracao < max_iter)) {
                var tmp = ((zx * zx) - (zy * zy)) + cx;
                zy = ((2.0 * zx) * zy) + cy;
                zx = tmp;
                iteracao = iteracao + 1;
            }
            if (iteracao == max_iter) { dentro = dentro + 1; }

            # Mapeia o número de iterações para um caractere (9 caracteres)
            tela[y][x] = caractere((iteracao * 8) / max_iter);
            x = x + 1;
        }
        y = y + 1;
    }

    if (mostrar == 1) {
        print("=== FRACTAL DE MANDELBROT (Gerado pelo Nucleo 5) ===");
        var linha = 0;
        while (linha < altura) {
            print(tela[linha]);
            linha = linha + 1;
        }
        print("====================================================");
    }
    return dentro;
}

# ------------------------------------------------------------------
# PASSO 4: EXECUÇÃO SEQUENCIAL E PARALELA (FORK & JOIN)
# ------------------------------------------------------------------
seq {
    # PASSO 2: cenário (40 alunos x 4 atividades = 160 atividades)
    var num_alunos = 40;
    var atividades_por_aluno = 4;
    var total_atividades = num_alunos * atividades_por_aluno;
    var num_avaliadores = 4;

    print("Carga de Trabalho:", total_atividades, "atividades + 1 Calculo de Fractal ASCII");
    print("");

    # --- 1. Modo sequencial: 1 núcleo (Professor) corrige tudo ---
    print("--- 1. Executando Modo Sequencial (Apenas 1 Nucleo / Professor) ---");
    var corrigidas_seq = trabalhador_nucleo(0, total_atividades);
    var pontos_seq = trabalhador_mandelbrot(50, 20, 100, 0);
    print("[Professor] Corrigiu", corrigidas_seq, "atividades e calculou o fractal");
    print("");

    # --- 2. Modo paralelo: 1 núcleo para cada avaliador ---
    print("--- 2. Executando Modo Paralelo (5 Nucleos Dedicados) ---");
    var tamanho_fatia = total_atividades / num_avaliadores;

    # ETAPA 1: FOR DE ALOCAÇÃO (fork dispara 1 tarefa por avaliador)
    var nucleos = [];
    for (var n in range(num_avaliadores)) {
        nucleos.append(fork trabalhador_nucleo(n * tamanho_fatia, (n + 1) * tamanho_fatia));
    }
    # 5º núcleo: fractal de Mandelbrot
    var nucleo_fractal = fork trabalhador_mandelbrot(50, 20, 100, 1);

    # O join do fractal vem primeiro: ele imprime o desenho, e o programa
    # principal só volta a imprimir depois que ele terminar.
    var pontos_par = join(nucleo_fractal);
    print("");

    # ETAPA 2: FOR DE SINCRONIZAÇÃO (join espera cada núcleo e junta o resultado)
    var corrigidas_par = 0;
    var id = 0;
    for (var tarefa in nucleos) {
        var feitas = join(tarefa);
        print(nome_avaliador(id), "corrigiu", feitas, "atividades");
        corrigidas_par = corrigidas_par + feitas;
        id = id + 1;
    }
    print("");

    print("==========================================");
    print("         RESULTADO DA AVALIACAO           ");
    print("==========================================");
    print("Atividades (sequencial) :", corrigidas_seq);
    print("Atividades (paralelo)   :", corrigidas_par);
    print("Pontos no fractal (seq) :", pontos_seq);
    print("Pontos no fractal (par) :", pontos_par);
    print("Nucleos no paralelo     :", num_avaliadores + 1);
    if ((corrigidas_seq == corrigidas_par) && (pontos_seq == pontos_par)) {
        print("Os dois modos deram o mesmo resultado.");
    } else {
        print("ERRO: os modos deram resultados diferentes.");
    }
    print("==========================================");
}
