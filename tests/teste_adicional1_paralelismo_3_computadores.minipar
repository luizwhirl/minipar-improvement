# Entradas: vetor; linhas A[0], A[1], B[0], B[1] das matrizes 2x2; numero do fatorial.
func quicksort_distribuido(arr) {
    var stack = [];
    if (len(arr) > 1) {
        stack.append(0);
        stack.append(len(arr) - 1);
    }
    while (len(stack) > 0) {
        var fim = stack.pop();
        var inicio = stack.pop();
        if (inicio >= fim) { continue; }
        var pivot = arr[fim];
        var i = inicio - 1;
        var j = inicio;
        while (j < fim) {
            if (arr[j] <= pivot) {
                i = i + 1;
                var aux = arr[i];
                arr[i] = arr[j];
                arr[j] = aux;
            }
            j = j + 1;
        }
        i = i + 1;
        var aux = arr[i];
        arr[i] = arr[fim];
        arr[fim] = aux;
        stack.append(inicio);
        stack.append(i - 1);
        stack.append(i + 1);
        stack.append(fim);
    }
    return arr;
}

func multiplicar_matrizes(a0, a1, b0, b1) {
    var a = matrix(2, 2, 0.0);
    var b = matrix(2, 2, 0.0);
    a[0] = a0;
    a[1] = a1;
    b[0] = b0;
    b[1] = b1;
    var resultado = matrix(2, 2, 0.0);
    var i = 0;
    while (i < 2) {
        var j = 0;
        while (j < 2) {
            var k = 0;
            while (k < 2) {
                resultado[i][j] = resultado[i][j] + (a[i][k] * b[k][j]);
                k = k + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return resultado;
}

func fatorial(numero) {
    var resultado = 1;
    var i = 1;
    while (i <= numero) {
        resultado = resultado * i;
        i = i + 1;
    }
    return resultado;
}

func fatorial_valido(numero) {
    var candidato = 0;
    while (candidato <= 12) {
        if (numero == candidato) { return true; }
        candidato = candidato + 1;
    }
    return false;
}

seq {
    print("==== Teste adicional 1: paralelismo com canais para 3 computadores ====");
    var vetor = parse_ints(input("PC1 - numeros para QuickSort, separados por espaco: "));
    var a0 = parse_ints(input("PC2 - primeira linha da matriz A (2 numeros): "));
    var a1 = parse_ints(input("PC2 - segunda linha da matriz A (2 numeros): "));
    var b0 = parse_ints(input("PC2 - primeira linha da matriz B (2 numeros): "));
    var b1 = parse_ints(input("PC2 - segunda linha da matriz B (2 numeros): "));
    var numero = to_number(input("PC3 - numero para o fatorial (inteiro de 0 a 12): "));

    if (len(a0) == 2 && len(a1) == 2 && len(b0) == 2 && len(b1) == 2 && fatorial_valido(numero)) {
        var canal_pc1 = c_channel("127.0.0.1", 5301);
        var canal_pc2 = c_channel("127.0.0.1", 5302);
        var canal_pc3 = c_channel("127.0.0.1", 5303);

        par {
            seq {
                var resultado1 = receive(canal_pc1);
                var resultado2 = receive(canal_pc2);
                var resultado3 = receive(canal_pc3);
                print("Resultados recolhidos no Computador 1:");
                print("PC1 QuickSort:", resultado1);
                print("PC2 Matrizes:", resultado2);
                print("PC3 Fatorial:", resultado3);
            }
            seq { send(canal_pc1, quicksort_distribuido(vetor)); }
            seq { send(canal_pc2, multiplicar_matrizes(a0, a1, b0, b1)); }
            seq { send(canal_pc3, fatorial(numero)); }
        }
    } else {
        print("Entrada invalida: cada linha das matrizes deve ter 2 numeros e o fatorial exige inteiro de 0 a 12.");
    }
}
