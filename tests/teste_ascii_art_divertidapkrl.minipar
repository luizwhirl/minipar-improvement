# Entrada: altura inteira do fractal, de 1 a 64 linhas.
seq {
    print("========================================");
    print("  FRACTAL DE SIERPINSKI (Automato)      ");
    print("========================================");
    var linhas = to_number(input("Altura do fractal (inteiro de 1 a 64): "));
    var inteiro = 1;
    while (inteiro < linhas && inteiro < 64) {
        inteiro = inteiro + 1;
    }
    if (linhas >= 1 && linhas <= 64 && linhas == inteiro) {
        var colunas = (linhas * 2) + 1;
        var tela = matrix(linhas, colunas, " ");
        var controle = matrix(linhas, colunas, 0);
        # Uma coluna de margem em cada lado preserva todas as celulas da ultima linha.
        var meio = linhas;
        controle[0][meio] = 1;
        tela[0][meio] = "A";
        var i = 1;
        while (i < linhas) {
            var j = 1;
            while (j < (colunas - 1)) {
                var esq = controle[i - 1][j - 1];
                var dir = controle[i - 1][j + 1];
                if ((esq + dir) == 1) {
                    controle[i][j] = 1;
                    tela[i][j] = "A";
                }
                j = j + 1;
            }
            i = i + 1;
        }
        print("Calculo finalizado. Renderizando...");
        var k = 0;
        while (k < linhas) {
            print(tela[k]);
            k = k + 1;
        }
        print("========================================");
    } else {
        print("Entrada invalida: informe uma altura inteira de 1 a 64.");
    }
}
